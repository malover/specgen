{
  "name": "arkts-indexing-spike",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "specgen": "./dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "description": "Native TypeScript Project SPEC generation, architecture checking, and automated evaluation",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "spike": "tsx src/cli.ts",
    "all": "tsx src/cli.ts all",
    "init-ground-truth": "tsx src/cli.ts init-ground-truth",
    "evaluate": "tsx src/cli.ts evaluate",
    "evaluate:quality": "tsx src/cli.ts evaluate-quality",
    "evaluate:full": "npm run build && node dist/src/cli.js evaluate-full",
    "evaluate:agent": "tsx src/cli.ts evaluate-agent",
    "agent:ab": "tsx src/cli.ts run-agent-ab",
    "init:architecture-eval": "tsx src/cli.ts init-architecture-eval",
    "project-spec": "tsx src/cli.ts project-spec",
    "query": "tsx src/cli.ts query"
  },
  "dependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "json5": "^2.2.3",
    "undici": "^7.29.0",
    "web-tree-sitter": "^0.25.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.5 <25"
  }
}
